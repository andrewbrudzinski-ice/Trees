# The Tree — local environment
# Copy this file to `.env.local` and fill in the two values from your Supabase
# project (Dashboard → Project Settings → API). Never commit `.env.local`.

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key — safe to expose in the browser.
# This is the "anon public" key (or the newer "publishable" key), NOT the
# service_role / secret key. The secret key never belongs in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Not needed yet (leave unset until a later roadmap step asks for it) ---
# SUPABASE_SERVICE_ROLE_KEY=   # server-only secret; used for privileged RPCs (Step 2+)
